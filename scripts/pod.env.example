# The secrets the GPU pod needs, by name only. Never write the values here or
# anywhere else in the repository: store them as Runpod secrets and give them
# to the pod as environment variables (docs/runbooks/pod.md).

# Hugging Face token with the Read role, for downloading the models.
HF_TOKEN=

# GitHub fine-grained token with read access to this repository's contents,
# for cloning and pulling it on the pod.
GITHUB_TOKEN=
